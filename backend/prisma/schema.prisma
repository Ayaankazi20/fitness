generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
}
enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  VERY_ACTIVE
  EXTREME
}
enum GoalType {
  LOSE_WEIGHT
  MAINTAIN
  GAIN_MUSCLE
  GAIN_WEIGHT
}
enum MealType {
  BREAKFAST
  LUNCH
  SNACK
  DINNER
}
enum ScanStatus {
  PROCESSING
  COMPLETED
  FAILED
  NO_FOOD
}
enum FoodSource {
  USDA
  INDIAN_LOCAL
  CUSTOM
  MOCK
}
enum MessageRole {
  USER
  ASSISTANT
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  passwordHash  String   @map("password_hash")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  profile       UserProfile?
  goals         FitnessGoal[]
  targets       NutritionTarget[]
  meals         Meal[]
  scans         FoodScan[]
  weightLogs    WeightLog[]
  dailyNutrition DailyNutrition[]
  conversations AiConversation[]
  refreshTokens RefreshToken[]
  passwordResets PasswordResetToken[]
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("refresh_tokens")
}

model UserProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  name         String
  age          Int
  gender       Gender
  heightCm     Float    @map("height_cm")
  weightKg     Float    @map("weight_kg")
  activityLevel ActivityLevel @map("activity_level")
  dietaryPreference String? @map("dietary_preference")
  allergies    String[]
  foodPreferences String[] @map("food_preferences")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_profiles")
}

model FitnessGoal {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  goalType     GoalType @map("goal_type")
  targetWeightKg Float? @map("target_weight_kg")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isActive])
  @@map("fitness_goals")
}

model NutritionTarget {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  calories   Int
  proteinG   Int      @map("protein_g")
  carbsG     Int      @map("carbs_g")
  fatG       Int      @map("fat_g")
  bmr        Int?
  tdee       Int?
  isManual   Boolean  @default(false) @map("is_manual")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isActive])
  @@map("nutrition_targets")
}

model FoodItem {
  id         String     @id @default(uuid()) @db.Uuid
  name       String
  normalizedName String @map("normalized_name")
  source     FoodSource
  externalId String     @map("external_id")
  aliases    String[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  nutrition  FoodNutrition?
  mealItems  MealItem[]
  @@unique([source, externalId])
  @@index([normalizedName])
  @@map("food_items")
}

model FoodNutrition {
  id         String   @id @default(uuid()) @db.Uuid
  foodItemId String   @unique @map("food_item_id") @db.Uuid
  caloriesPer100g Float @map("calories_per_100g")
  proteinPer100g  Float @map("protein_per_100g")
  carbsPer100g    Float @map("carbs_per_100g")
  fatPer100g      Float @map("fat_per_100g")
  fiberPer100g    Float @default(0) @map("fiber_per_100g")
  sugarPer100g    Float @default(0) @map("sugar_per_100g")
  sodiumMgPer100g Float @default(0) @map("sodium_mg_per_100g")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  @@map("food_nutrition")
}

model FoodScan {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  status        ScanStatus @default(PROCESSING)
  detectedFoods Json?      @map("detected_foods")
  overallConfidence Float? @map("overall_confidence")
  notes         String?
  errorCode     String?    @map("error_code")
  finalFoods    Json?      @map("final_foods")
  mealId        String?    @unique @map("meal_id") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  meal          Meal?      @relation(fields: [mealId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@map("food_scans")
}

model Meal {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  mealType  MealType @map("meal_type")
  eatenAt   DateTime @map("eaten_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     MealItem[]
  scan      FoodScan?
  @@index([userId, eatenAt])
  @@map("meals")
}

model MealItem {
  id        String   @id @default(uuid()) @db.Uuid
  mealId    String   @map("meal_id") @db.Uuid
  foodItemId String? @map("food_item_id") @db.Uuid
  name      String
  weightG   Float    @map("weight_g")
  calories  Float
  proteinG  Float    @map("protein_g")
  carbsG    Float    @map("carbs_g")
  fatG      Float    @map("fat_g")
  fiberG    Float    @default(0) @map("fiber_g")
  sugarG    Float    @default(0) @map("sugar_g")
  sodiumMg  Float    @default(0) @map("sodium_mg")
  aiDetected Boolean @default(false) @map("ai_detected")
  confidence Float?
  createdAt DateTime @default(now()) @map("created_at")
  meal      Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodItem  FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: SetNull)
  @@index([mealId])
  @@map("meal_items")
}

model WeightLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  weightKg  Float    @map("weight_kg")
  loggedOn  DateTime @map("logged_on") @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, loggedOn])
  @@map("weight_logs")
}

/// Optional materialized rollup (see docs/database.md). Dashboard reads aggregate from meal_items directly.
model DailyNutrition {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @db.Date
  calories  Float    @default(0)
  proteinG  Float    @default(0) @map("protein_g")
  carbsG    Float    @default(0) @map("carbs_g")
  fatG      Float    @default(0) @map("fat_g")
  mealCount Int      @default(0) @map("meal_count")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, date])
  @@map("daily_nutrition")
}

model AiConversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]
  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String
  createdAt      DateTime @default(now()) @map("created_at")
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model UsageCounter {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  feature   String
  period    String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")
  @@unique([userId, feature, period])
  @@map("usage_counters")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}
